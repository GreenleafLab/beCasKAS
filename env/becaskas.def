# Apptainer recipe for the beCasKAS pipeline.

Bootstrap: docker
From: mambaorg/micromamba:1.5.8

%labels
    org.opencontainers.image.source https://github.com/GreenleafLab/beCasKAS
    org.opencontainers.image.description beCasKAS Nextflow pipeline tools
    org.opencontainers.image.licenses MIT

%files
    env/env.yaml /opt/build/env.yaml

%post
    set -eux
    # System deps for KAS-Analyzer wrapper, picard, gatk, R packages requiring system libs.
    apt-get update && apt-get install -y --no-install-recommends \
        bash \
        ca-certificates \
        curl \
        wget \
        unzip \
        git \
        openjdk-17-jre-headless \
        procps \
        libxml2-dev \
        libcurl4-openssl-dev \
        libssl-dev \
        libfontconfig1-dev \
        libharfbuzz-dev \
        libfribidi-dev \
        libfreetype6-dev \
        libpng-dev \
        libtiff5-dev \
        libjpeg-dev \
        libxt-dev \
        libcairo2-dev
    rm -rf /var/lib/apt/lists/*

    # Conda env
    micromamba install -y -n base -f /opt/build/env.yaml
    micromamba clean --all --yes
    export PATH=/opt/conda/bin:$PATH
    Rscript -e 'if (!requireNamespace("GenomeInfoDbData", quietly = TRUE)) BiocManager::install("GenomeInfoDbData", update = FALSE, ask = FALSE, type = "source")'
    Rscript -e 'stopifnot(requireNamespace("GenomeInfoDbData", quietly = TRUE)); library(DiffBind); cat("DiffBind stack OK\n")'

    # KAS-Analyzer 2.0.0
    git clone --depth 1 --branch v2.0.0 https://github.com/Ruitulyu/KAS-Analyzer.git /opt/KAS-Analyzer
    chmod +x /opt/KAS-Analyzer/KAS-pipe2
    chmod 755 /opt/KAS-Analyzer/scripts/*.sh
    ln -s /opt/KAS-Analyzer/KAS-pipe2 /opt/KAS-Analyzer/KAS-Analyzer
    sed -i '1s|^#!/usr/bin/python$|#!/usr/bin/env python3|' /opt/KAS-Analyzer/src/SAMtoBED
    Rscript -e 'remotes::install_github("kassambara/easyGgplot2", upgrade = "never")'

%environment
    export MAMBA_ROOT_PREFIX=/opt/conda
    export PATH=/opt/KAS-Analyzer:/opt/conda/bin:$PATH

%test
    trim_galore --version
    bowtie2 --version | head -1
    KAS-Analyzer --help > /dev/null
    samtools --version | head -1
    macs2 --version
    picard MarkDuplicates --version 2>&1 | head -1
    gencore --version 2>&1 | head -1
    gatk --version | head -1
    bcftools --version | head -1
    bedtools --version
    guidescan --version
    bedGraphToBigWig 2>&1 | head -1 || true
    /opt/KAS-Analyzer/src/SAMtoBED --help > /dev/null 2>&1 || /opt/KAS-Analyzer/src/SAMtoBED -h > /dev/null 2>&1 || true
    head -1 /opt/KAS-Analyzer/src/SAMtoBED | grep -q 'python3'
    Rscript -e 'stopifnot(requireNamespace("GenomeInfoDbData", quietly = TRUE))'
    Rscript -e 'library(DiffBind); cat(as.character(packageVersion("DiffBind")), "\n")'
    Rscript -e 'library(devtools); library(easyGgplot2); cat("easyGgplot2 OK\n")'

%runscript
    exec /bin/bash "$@"
