manifest {
    name            = 'beCasKAS'
    author          = 'Wang T. et al.'
    homePage        = 'https://github.com/GreenleafLab/beCasKAS'
    description     = 'Reproducible Nextflow pipeline for beCasKAS off-target base editor analysis'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.04.0'
    version         = '0.1.0'
}

// Default parameters (overridable via CLI, params file, or profile)
params {
    // input
    samplesheet           = null              // required
    outdir                = 'results'

    // references — pre-staged directory (see README for required layout)
    reference_dir         = null              // required

    // trim_align
    clip_r2               = 12

    // peak_call (MACS2 via KAS-Analyzer)
    macs2_mode            = 'sharp'

    // differential_peaks (DiffBind)
    fdr                   = 0.05
    lfc                   = 1
    min_overlap           = 2
    greylist              = false
    n_pseudo_replicates   = 3

    // reproducibility
    seed                  = 42

    // resource caps
    max_cpus              = 16
    max_memory            = '128.GB'
    max_time              = '48.h'

    // help/version
    help                  = false

    // schema validation
    validate_params       = true
    schema_ignore_params  = ''
}

// Load combined pipeline defaults (process resources + per-process settings + named genome profiles)
includeConfig 'nextflow/configs/nextflow.config'

// Profiles
profiles {

    docker {
        docker.enabled         = true
        docker.runOptions      = '-u $(id -u):$(id -g)'
        singularity.enabled    = false
    }

    apptainer {
        apptainer.enabled      = true
        apptainer.autoMounts   = true
        singularity.enabled    = false
        docker.enabled         = false
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
    }

    slurm {
        includeConfig 'nextflow/configs/slurm.config'
    }
}

// Container support is deferred — see README. Users currently supply tools via local
// install (matching the dependency list documented in the README) or a self-built image
// passed via `-c` or `process.container = '<your-image>'`.

// Plugins (nf-validation for schema enforcement)
plugins {
    id 'nf-validation@1.1.3'
}

// Reporting
report {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/execution_report.html"
    overwrite = true
}
timeline {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/execution_timeline.html"
    overwrite = true
}
trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/execution_trace.txt"
    overwrite = true
}
dag {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/pipeline_dag.svg"
    overwrite = true
}
