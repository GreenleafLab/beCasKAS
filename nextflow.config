manifest {
    name            = 'beCasKAS'
    author          = 'Wang T. et al.'
    homePage        = 'https://github.com/GreenleafLab/beCasKAS'
    description     = 'Reproducible Nextflow pipeline for beCasKAS off-target base editor analysis'
    mainScript      = 'main.nf'
    nextflowVersion = '>=25.10.0'
    version         = '0.1.0'
}

// Default parameters (overridable via CLI, params file, or profile)
params {
    samplesheet           = null
    refdir                = null
    outdir                = 'results'
    clip_r2               = 12
    macs2_mode            = 'sharp'
    fdr                   = 0.05
    lfc                   = 1
    min_overlap           = 2
    greylist              = false
    diffbind_params       = null
    stage                 = 'all'
    diffbind_samplesheet_dir = null
    n_pseudo_replicates   = 3
    seed                  = 42
    guidescan_grna        = null
    guidescan_pam         = 'NGG'
    guidescan_mismatches  = 10
    guidescan_rna_bulges  = 2
    guidescan_dna_bulges  = 2
    guidescan_chunk_size  = 15
    max_cpus              = 16
    max_memory            = '128.GB'
    max_time              = '48.h'
    partition             = 'sfgf,wjg,biochem,normal'
    clusterOptions        = null
    help                  = false
    validate_params       = true
    schema_ignore_params  = 'diffbind_params,diffbind_samplesheet_dir'
    container             = "${projectDir}/becaskas.sif"
}

// Load process defaults
includeConfig 'nextflow/configs/process.config'

process {
    container = params.container
    executor       = 'slurm'
    queue          = { params.partition }
    clusterOptions = { params.clusterOptions }
}

executor {
    queueSize       = 50
    submitRateLimit = '10 sec'
}

apptainer {
    enabled    = true
    autoMounts = true
}

// Profiles
profiles {

    local {
        process.executor       = 'local'
        process.resourceLimits = [
            cpus  : nextflow.util.SysHelper.getAvailCpus(),
            memory: nextflow.util.SysHelper.getAvailMemory(),
            time  : (params.max_time as nextflow.util.Duration)
        ]
    }

    slurm {
        process.executor = 'slurm'
    }

    docker {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }

    apptainer {
        apptainer.enabled      = true
        apptainer.autoMounts   = true
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }
}


// Plugins (nf-validation for schema enforcement)
plugins {
    id 'nf-validation@1.1.3'
}

// Reporting
report {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/report.html"
    overwrite = true
}
timeline {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/timeline.html"
    overwrite = true
}
trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/trace.txt"
    overwrite = true
}
dag {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/pipeline_dag.svg"
    overwrite = true
}
