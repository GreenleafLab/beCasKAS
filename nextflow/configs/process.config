// Nextflow Pipeline Default Configs

// =====================================================================================
// Process resource defaults via labels
// =====================================================================================
process {
    resourceLimits = [
        cpus  : (params.max_cpus   as int),
        memory: (params.max_memory as nextflow.util.MemoryUnit),
        time  : (params.max_time   as nextflow.util.Duration)
    ]

    cpus      = { 1    * task.attempt }
    memory    = { 4.GB * task.attempt }
    time      = { 4.h  * task.attempt }

    // Cap BLAS/OpenMP thread pools to the allocation so NumPy/SciPy/R/BLAS-backed
    // tools without an explicit --threads flag don't oversubscribe shared nodes.
    beforeScript = {
        """
        export OMP_NUM_THREADS=${task.cpus}
        export OPENBLAS_NUM_THREADS=${task.cpus}
        export MKL_NUM_THREADS=${task.cpus}
        export NUMEXPR_NUM_THREADS=${task.cpus}
        export VECLIB_MAXIMUM_THREADS=${task.cpus}
        """
    }

    errorStrategy = { task.exitStatus in [137, 139, 140, 143, 247] ? 'retry' : 'terminate' }
    maxRetries    = 2

    withLabel: 'process_low' {
        cpus   = { 2     * task.attempt }
        memory = { 8.GB  * task.attempt }
        time   = { 4.h   * task.attempt }
    }
    withLabel: 'process_medium' {
        cpus   = { 8     * task.attempt }
        memory = { 32.GB * task.attempt }
        time   = { 12.h  * task.attempt }
    }
    withLabel: 'process_high' {
        cpus   = { 16    * task.attempt }
        memory = { 96.GB * task.attempt }
        time   = { 24.h  * task.attempt }
    }
}

// =====================================================================================
// Per-process setting overrides
// =====================================================================================
process {

    withName: 'TRIM_ALIGN' {
        cpus   = { 8     * task.attempt }
        memory = { 48.GB * task.attempt }
        time   = { 12.h  * task.attempt }
        publishDir = [
            [
                path: { "${params.outdir}/01_trim_align/${sample.id}" },
                mode: 'copy',
                pattern: '{Bam_files,Bed_files,BedGraph_files}/*',
                saveAs: { fn -> fn.tokenize('/').last() }
            ],
            [
                path: { "${params.outdir}/01_trim_align/${sample.id}" },
                mode: 'copy',
                pattern: '*.{html,zip,txt}'
            ]
        ]
    }

    withName: 'PEAK_CALL' {
        cpus   = { 2     * task.attempt }
        memory = { 16.GB * task.attempt }
        time   = { 4.h   * task.attempt }
        publishDir = [
            path: { "${params.outdir}/02_peaks/${sample.id}" },
            mode: 'copy',
            pattern: '*.{bed,xls}'
        ]
    }

    withName: 'KAS_STATISTICS' {
        cpus   = { 1      * task.attempt }
        memory = { 4.GB   * task.attempt }
        time   = { 2.h    * task.attempt }
        publishDir = [
            path: { "${params.outdir}/03_normalization" },
            mode: 'copy',
            pattern: '*.{txt}'
        ]
    }

    withName: 'NORMALIZE_BIGWIG' {
        cpus   = { 2     * task.attempt }
        memory = { 64.GB * task.attempt }
        time   = { 4.h   * task.attempt }
        publishDir = [
            path: { "${params.outdir}/03_bigwigs" },
            mode: 'copy',
            pattern: '*.{bigWig,bg}',
            saveAs: { fn ->
                def name = fn.tokenize('/').last()
                def sid  = name.replaceAll(/\.nor\.(bigWig|bg)$/, '')
                "${sid}/${name}"
            }
        ]
    }

    withName: 'QC_METRICS' {
        cpus   = { 2     * task.attempt }
        memory = { 16.GB * task.attempt }
        time   = { 4.h   * task.attempt }
        publishDir = [
            path: { "${params.outdir}/04_qc" },
            mode: 'copy',
            pattern: '*.{pdf,txt,tab,npz}'
        ]
    }

    withName: 'DEDUP_CONSENSUS' {
        cpus   = { 2     * task.attempt }
        memory = { 24.GB * task.attempt }
        time   = { 8.h   * task.attempt }
        publishDir = [
            path: { "${params.outdir}/05_dedup/${sample.id}" },
            mode: 'copy',
            pattern: '*.{bam,bam.bai,html}'
        ]
    }

    withName: 'SPLIT_BAM_PSEUDOREPS' {
        cpus   = { 1     * task.attempt }
        memory = { 16.GB * task.attempt }
        time   = { 4.h   * task.attempt }
        publishDir = [
            path: { "${params.outdir}/05_dedup/${sample.id}/pseudoreps" },
            mode: 'copy',
            pattern: '*.{bam,bam.bai}'
        ]
    }

    withName: 'DIFFERENTIAL_PEAKS' {
        cpus   = { 4     * task.attempt }
        memory = { 48.GB * task.attempt }
        time   = { 8.h   * task.attempt }
        publishDir = [
            path: { "${params.outdir}/06_differential/${case_id}" },
            mode: 'copy',
            pattern: '*.{bed,tsv,pdf,rds,txt}'
        ]
    }

    withName: 'CALL_VARIANTS' {
        cpus   = { 8     * task.attempt }
        memory = { 24.GB * task.attempt }
        time   = { 8.h   * task.attempt }
        publishDir = [
            path: { "${params.outdir}/07_variants/${case_id}/${sample.id}" },
            mode: 'copy',
            pattern: '*.{vcf,vcf.gz,vcf.gz.tbi}'
        ]
    }

    withName: 'BUILD_DIFFBIND_SAMPLESHEET' {
        cpus   = { 1      * task.attempt }
        memory = { 2.GB   * task.attempt }
        time   = { 30.min * task.attempt }
        publishDir = [
            path: { "${params.outdir}/06_differential/samplesheets" },
            mode: 'copy',
            pattern: 'diffbind_samplesheet_*.csv'
        ]
    }
}
