// Nextflow Pipeline Default Configs

// =====================================================================================
// Process resource defaults via labels
// =====================================================================================
process {
    cpus      = { check_max( 1    * task.attempt, 'cpus'   ) }
    memory    = { check_max( 4.GB * task.attempt, 'memory' ) }
    time      = { check_max( 4.h  * task.attempt, 'time'   ) }

    errorStrategy = { task.exitStatus in [137, 139, 143, 247] ? 'retry' : 'terminate' }
    maxRetries    = 2

    withLabel: 'process_low' {
        cpus   = { check_max( 2     * task.attempt, 'cpus'   ) }
        memory = { check_max( 8.GB  * task.attempt, 'memory' ) }
        time   = { check_max( 4.h   * task.attempt, 'time'   ) }
    }
    withLabel: 'process_medium' {
        cpus   = { check_max( 8     * task.attempt, 'cpus'   ) }
        memory = { check_max( 32.GB * task.attempt, 'memory' ) }
        time   = { check_max( 12.h  * task.attempt, 'time'   ) }
    }
    withLabel: 'process_high' {
        cpus   = { check_max( 16    * task.attempt, 'cpus'   ) }
        memory = { check_max( 96.GB * task.attempt, 'memory' ) }
        time   = { check_max( 24.h  * task.attempt, 'time'   ) }
    }
}

// Cap helper (clamps to params.max_*)
def check_max(obj, type) {
    if (type == 'memory') {
        try {
            def cap = (params.max_memory as nextflow.util.MemoryUnit)
            return obj.compareTo(cap) == 1 ? cap : obj
        } catch (all) { return obj }
    } else if (type == 'time') {
        try {
            def cap = (params.max_time as nextflow.util.Duration)
            return obj.compareTo(cap) == 1 ? cap : obj
        } catch (all) { return obj }
    } else if (type == 'cpus') {
        try {
            return Math.min(obj as int, params.max_cpus as int)
        } catch (all) { return obj }
    }
    return obj
}

// =====================================================================================
// Per-process overrides
// =====================================================================================
process {

    withName: 'TRIM_ALIGN' {
        publishDir = [
            path: { "${params.outdir}/01_trim_align/${meta.id}" },
            mode: 'copy',
            pattern: '*.{bam,bam.bai,bed,bg,html,zip,txt}'
        ]
        label = 'process_high'
    }

    withName: 'PEAK_CALL' {
        publishDir = [
            path: { "${params.outdir}/02_peaks/${meta.id}" },
            mode: 'copy',
            pattern: '*.{bed,xls}'
        ]
        label = 'process_medium'
    }

    withName: 'KAS_STATISTICS' {
        publishDir = [
            path: { "${params.outdir}/03_normalization" },
            mode: 'copy',
            pattern: '*.{txt}'
        ]
        label = 'process_low'
    }

    withName: 'NORMALIZE_BIGWIG' {
        publishDir = [
            path: { "${params.outdir}/03_bigwigs/${meta.id}" },
            mode: 'copy',
            pattern: '*.{bigWig,bg}'
        ]
        label = 'process_medium'
    }

    withName: 'QC_METRICS' {
        publishDir = [
            path: { "${params.outdir}/04_qc" },
            mode: 'copy',
            pattern: '*.{pdf,txt,tab,npz}'
        ]
        label = 'process_medium'
    }

    withName: 'DEDUP_CONSENSUS' {
        publishDir = [
            path: { "${params.outdir}/05_dedup/${meta.id}" },
            mode: 'copy',
            pattern: '*.{bam,bam.bai,html}'
        ]
        label = 'process_medium'
    }

    withName: 'SPLIT_BAM_PSEUDOREPS' {
        publishDir = [
            path: { "${params.outdir}/05_dedup/${meta.id}/pseudoreps" },
            mode: 'copy',
            pattern: '*.{bam,bam.bai}'
        ]
        label = 'process_low'
    }

    withName: 'DIFFERENTIAL_PEAKS' {
        publishDir = [
            path: { "${params.outdir}/06_differential" },
            mode: 'copy',
            pattern: '*.{bed,tsv,pdf,rds,txt}'
        ]
        label = 'process_high'
    }

    withName: 'CALL_VARIANTS' {
        publishDir = [
            path: { "${params.outdir}/07_variants/${meta.id}" },
            mode: 'copy',
            pattern: '*.{vcf,vcf.gz,vcf.gz.tbi}'
        ]
        label = 'process_high'
    }
}

