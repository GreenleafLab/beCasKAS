// Template SLURM executor profile. Users customize partition, account, etc.

process {
    executor       = 'slurm'
    queue          = 'normal'    // <-- CUSTOMIZE: your cluster's partition name
    // clusterOptions = '--account=<your_account>'   // uncomment + set if your cluster requires
    // queueSize      = 100                          // optional: max concurrent jobs
}

executor {
    queueSize       = 50
    submitRateLimit = '10 sec'
}
