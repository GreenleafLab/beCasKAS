{
    "$schema": "http://json-schema.org/draft-07/schema",
    "$id": "https://raw.githubusercontent.com/GreenleafLab/beCasKAS/main/nextflow/configs/nextflow_schema.json",
    "title": "beCasKAS pipeline parameters",
    "description": "Reproducible Nextflow pipeline for beCasKAS off-target base editor analysis",
    "type": "object",
    "definitions": {
        "input_output_options": {
            "title": "Input/output options",
            "type": "object",
            "required": ["samplesheet"],
            "properties": {
                "samplesheet": {
                    "type": "string",
                    "format": "file-path",
                    "schema": "nextflow/configs/samplesheet_schema.json",
                    "description": "Path to samplesheet CSV with columns: sample_id, fastq_1, fastq_2, condition, replicate, background_id"
                },
                "outdir": {
                    "type": "string",
                    "format": "directory-path",
                    "default": "results",
                    "description": "Output directory"
                }
            }
        },
        "reference_options": {
            "title": "Reference data options",
            "type": "object",
            "required": ["refdir"],
            "properties": {
                "refdir": {
                    "type": "string",
                    "format": "directory-path",
                    "description": "Directory containing pre-staged hg38 references in a flat layout (all files at the top level, no subdirectories). Required files: hg38.fasta, hg38.fasta.fai, hg38.dict, hg38.genome (chrom sizes), hg38.{1,2,3,4,rev.1,rev.2}.bt2 (bowtie2 index prefix hg38), af-only-gnomad.hg38.vcf.gz(.tbi), 1000g_pon.hg38.vcf.gz(.tbi). User is responsible for staging these files; see README."
                }
            }
        },
        "trim_align_options": {
            "title": "trim_align step",
            "type": "object",
            "properties": {
                "clip_r2": {
                    "type": "integer",
                    "default": 12,
                    "description": "Bases to clip from 5' of R2 (adaptase library prep)"
                }
            }
        },
        "peak_call_options": {
            "title": "peak_call step",
            "type": "object",
            "properties": {
                "macs2_mode": {
                    "type": "string",
                    "enum": ["sharp", "broad"],
                    "default": "sharp",
                    "description": "MACS2 mode (KAS-Analyzer peakscalling -b flag)"
                }
            }
        },
        "staging_options": {
            "title": "Pipeline staging",
            "type": "object",
            "properties": {
                "stage": {
                    "type": "string",
                    "enum": ["all", "kas_analyzer", "diffbind"],
                    "default": "all",
                    "description": "Which stage(s) to run. 'all' = full pipeline; 'kas_analyzer' = stop after the per-case DiffBind samplesheets; 'diffbind' = run the differential + variant stage (use with -resume after a kas_analyzer run)."
                }
            }
        },
        "differential_peaks_options": {
            "title": "differential_peaks step",
            "type": "object",
            "properties": {
                "fdr": {
                    "type": "number",
                    "default": 0.05,
                    "minimum": 0,
                    "maximum": 1,
                    "description": "FDR cutoff for differential peaks"
                },
                "lfc": {
                    "type": "number",
                    "default": 1,
                    "description": "log2 fold-change cutoff"
                },
                "min_overlap": {
                    "type": "integer",
                    "default": 2,
                    "minimum": 1,
                    "description": "DiffBind minOverlap (peaks present in N+ samples to enter consensus)"
                },
                "greylist": {
                    "type": "boolean",
                    "default": false,
                    "description": "Apply DiffBind greylist masking"
                },
                "n_pseudo_replicates": {
                    "type": "integer",
                    "default": 3,
                    "minimum": 2,
                    "description": "Pseudo-replicates per condition when only n=1 sample is provided"
                }
            }
        },
        "reproducibility_options": {
            "title": "Reproducibility",
            "type": "object",
            "properties": {
                "seed": {
                    "type": "integer",
                    "default": 42,
                    "description": "Random seed used by R analyses and BAM-split partitioning"
                }
            }
        },
        "guidescan_options": {
            "title": "guidescan step (optional)",
            "type": "object",
            "properties": {
                "guidescan_grna": {
                    "type": "string",
                    "description": "gRNA spacer sequence (20 nt, no PAM) to search for within each case's differential peaks via GuideScan2. When unset (default), the GUIDESCAN_BINDING_SITES step does not run."
                },
                "guidescan_pam": {
                    "type": "string",
                    "default": "NGG",
                    "description": "PAM pattern (N = wildcard)"
                },
                "guidescan_mismatches": {
                    "type": "integer",
                    "default": 10,
                    "minimum": 0,
                    "description": "Max mismatches in the spacer"
                },
                "guidescan_rna_bulges": {
                    "type": "integer",
                    "default": 2,
                    "minimum": 0,
                    "description": "Max 1-nt RNA bulges"
                },
                "guidescan_dna_bulges": {
                    "type": "integer",
                    "default": 2,
                    "minimum": 0,
                    "description": "Max 1-nt DNA bulges"
                },
                "guidescan_chunk_size": {
                    "type": "integer",
                    "default": 15,
                    "minimum": 1,
                    "description": "Peaks processed together as one GuideScan2 index+enumerate unit"
                }
            }
        },
        "resource_options": {
            "title": "Resource caps",
            "type": "object",
            "properties": {
                "max_cpus": {
                    "type": "integer",
                    "default": 16
                },
                "max_memory": {
                    "type": "string",
                    "default": "128.GB"
                },
                "max_time": {
                    "type": "string",
                    "default": "48.h"
                }
            }
        },
        "generic_options": {
            "title": "Generic options",
            "type": "object",
            "properties": {
                "help": {
                    "type": "boolean",
                    "default": false,
                    "description": "Display help text"
                },
                "validate_params": {
                    "type": "boolean",
                    "default": true,
                    "description": "Validate parameters against the schema at runtime"
                },
                "schema_ignore_params": {
                    "type": "string",
                    "default": "",
                    "description": "Comma-separated list of parameter names to ignore during schema validation"
                },
                "container": {
                    "type": "string",
                    "description": "Path to the Apptainer/Singularity/Docker image used by all processes"
                }
            }
        }
    },
    "allOf": [
        {"$ref": "#/definitions/input_output_options"},
        {"$ref": "#/definitions/reference_options"},
        {"$ref": "#/definitions/trim_align_options"},
        {"$ref": "#/definitions/peak_call_options"},
        {"$ref": "#/definitions/staging_options"},
        {"$ref": "#/definitions/differential_peaks_options"},
        {"$ref": "#/definitions/reproducibility_options"},
        {"$ref": "#/definitions/guidescan_options"},
        {"$ref": "#/definitions/resource_options"},
        {"$ref": "#/definitions/generic_options"}
    ]
}
