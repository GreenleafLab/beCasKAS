# Apptainer recipe for the beCasKAS pipeline.
# Build (from repo root): apptainer build --fakeroot becaskas.sif nextflow/containers/becaskas.def
# See README.md "Container support" for usage.

Bootstrap: docker
From: mambaorg/micromamba:1.5.8

%labels
    org.opencontainers.image.source https://github.com/GreenleafLab/beCasKAS
    org.opencontainers.image.description beCasKAS Nextflow pipeline tools
    org.opencontainers.image.licenses MIT

%files
    nextflow/containers/env.yaml /tmp/env.yaml
    nextflow/containers/install-r-packages.R /tmp/install-r-packages.R

%post
    # System deps for KAS-Analyzer wrapper, picard, gatk, R packages requiring system libs.
    apt-get update && apt-get install -y --no-install-recommends \
        bash \
        ca-certificates \
        curl \
        wget \
        unzip \
        git \
        openjdk-17-jre-headless \
        procps \
        libxml2-dev \
        libcurl4-openssl-dev \
        libssl-dev \
        libfontconfig1-dev \
        libharfbuzz-dev \
        libfribidi-dev \
        libfreetype6-dev \
        libpng-dev \
        libtiff5-dev \
        libjpeg-dev \
        libxt-dev \
        libcairo2-dev
    rm -rf /var/lib/apt/lists/*

    # Conda env with bioinformatics tools (R, BWA, samtools, MACS2, etc.)
    micromamba install -y -n base -f /tmp/env.yaml
    micromamba clean --all --yes

    # KAS-Analyzer 1.0 (clone + add to PATH)
    git clone --depth 1 --branch v1.0 https://github.com/Ruitulyu/KAS-Analyzer.git /opt/KAS-Analyzer
    chmod +x /opt/KAS-Analyzer/KAS-Analyzer

    # Install R/Bioconductor packages (DiffBind + deps).
    # %post runs without conda env activation, so use absolute path to Rscript.
    /opt/conda/bin/Rscript /tmp/install-r-packages.R

    # Sanity check: verify each tool runs. Absolute paths used because %post has no PATH activation.
    /opt/conda/bin/trim_galore --version
    /opt/conda/bin/bowtie2 --version | head -1
    /opt/KAS-Analyzer/KAS-Analyzer --help > /dev/null
    /opt/conda/bin/samtools --version | head -1
    /opt/conda/bin/macs2 --version
    /opt/conda/bin/picard MarkDuplicates --version 2>&1 | head -1
    /opt/conda/bin/gencore --version 2>&1 | head -1
    /opt/conda/bin/gatk --version | head -1
    /opt/conda/bin/bcftools --version | head -1
    /opt/conda/bin/bedtools --version
    /opt/conda/bin/bedGraphToBigWig 2>&1 | head -1 || true
    /opt/conda/bin/Rscript -e 'library(DiffBind); cat(as.character(packageVersion("DiffBind")), "\n")'

%environment
    # Runtime PATH: ensures tools resolve without entrypoint activation.
    # Important for Apptainer/Singularity which bypass Docker ENTRYPOINT.
    export PATH=/opt/KAS-Analyzer:/opt/conda/bin:$PATH

%runscript
    exec /bin/bash "$@"
